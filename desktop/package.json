{
  "name": "boingai-desktop",
  "version": "1.0.0",
  "description": "BoingAI desktop",
  "author": "BoingAI",
  "license": "MIT",
  "homepage": "https://boingai.app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux deb rpm",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg pkg"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.boingai.app",
    "productName": "BoingAI",
    "copyright": "Copyright \u00a9 2026 BoingAI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/boingai",
        "to": "boingai"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "BoingAI <hello@boingai.local>",
      "artifactName": "BoingAI-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "BoingAI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BoingAI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "LICENSE.electron.txt",
      "welcomePage": true,
      "finishPage": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "language": "1033",
      "multiLanguageInstaller": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "BoingAI-${version}-${arch}.${ext}"
    }
  }
}
